+  });
+
+  test("a corner click without movement commits nothing", async () => {
+    const { container, wrapper, bubble, handle } = await renderCornerFixture("คลิกเฉยๆ");
+    mockCanvasRect(container);
+    const initial = {
+      left: wrapper.style.left, top: wrapper.style.top,
