+  vi.spyOn(HTMLCanvasElement.prototype,'toDataURL').mockReturnValue('data:render');
+});
+afterEach(()=>{vi.useRealTimers();vi.restoreAllMocks();});
+const sizing=():SourceSizing=>({mode:'auto',status:'matched',baseFontSizePx:5,
